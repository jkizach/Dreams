<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- BorderPane og ikke AnchorPane med faste layoutX/layoutY: så følger teksten med når man
     trækker vinduet større, i stedet for at stå fast i et hjørne. -->
<BorderPane prefHeight="640.0" prefWidth="720.0" xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="fixit.dreams.TxtController">
   <center>
      <!-- fitToWidth er dét der får afsnittene til at ombryde efter vinduets bredde.
           styleClass="text-area" er ikke en fejl: temaet har allerede farvet scrollbaren for
           tekstfelter, og de regler ligger i BRUGERENS egen currentTema.css. Ved at bruge
           samme klasse arver vinduet den styling - også hos alle der har haft appen længe og
           derfor aldrig får nye regler ud (se CSSUpdater.copyCssIfNotExists). -->
      <ScrollPane fx:id="txtviewScroll" fitToWidth="true" hbarPolicy="NEVER" styleClass="text-area"
                  BorderPane.alignment="CENTER">
         <content>
            <VBox fx:id="txtviewIndhold">
               <padding>
                  <Insets top="28.0" right="36.0" bottom="28.0" left="36.0" />
               </padding>
            </VBox>
         </content>
      </ScrollPane>
   </center>
   <bottom>
      <HBox alignment="CENTER_RIGHT" BorderPane.alignment="CENTER">
         <children>
            <Button mnemonicParsing="false" onAction="#closePopup" text="Luk" />
         </children>
         <padding>
            <Insets top="12.0" right="20.0" bottom="16.0" left="20.0" />
         </padding>
      </HBox>
   </bottom>
</BorderPane>
